    stp MSG1,"Message:"
    ieq MSG1,"/r",chat2
    ieq MSG1,"/file",FILES2
    ieq MSG1,"/FILE",FILES2
    ieq MSG1,"/whois",whoiam2
    ieq MSG1,"/color",color12
    ieq MSG1,"/ROOT",RMENU22
    ieq MSG1,"/q",leave2
    e "SENDING..."
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt"
    af "%SNAMME% said:","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt"
    af "%MSG1%","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt"
    af "%time% %date%","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt"
    g chat2
    l leave2
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt"
    af "%SNAMME% left!","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt"
    g CCHOICE
    l color12
    clr 17
    g chat2
    l RMENU22
    stp RPASS,"Password:"
    ieq RPASS,"DSOFT",RMENU
    e "Invalid Password."
    e ""
    p
    g chat2
    l whoiam2
    e "You are %SNAMME% (%username%)."
    e ""
    e "Everyone else is:"
    t "\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    e ""
    p
    g chat2
    ; ::CHATROOM 3 33333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333333
    l 3
    af "","\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    af "user %SNAMME% is %username%","\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    af "%SNAMME% entered chat.","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    g chat3
    l chat3
    iex "\\E026060n01\room308\SERVER\ANONCHAT\BANS\%USERNAME%.txt",USERBAN
    cls
    e "Welcome to Chatroom C."
    e "Type /q to exit."
    e "type /r to refresh."
    e "type /whois to see who you are."
    e ""
    t "\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    e ""
    e "%SNAMME% in Chatroom C."
    stp MSG1,"Message:"
    ieq MSG1,"/r",chat3
    ieq MSG1,"/whois",whoiam3
    ieq MSG1,"/file",FILES3
    ieq MSG1,"/FILE",FILES3
    ieq MSG1,"/color",color13
    ieq MSG1,"/ROOT",RMENU23
    ieq MSG1,"/q",leave3
    e "SENDING..."
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    af "%SNAMME% said:","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    af "%MSG1%","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    af "%time% %date%","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    g chat3
    l leave3
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    af "%SNAMME% left!","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    g CCHOICE
    l color13
    clr 17
    g chat3
    l RMENU23
    stp RPASS,"Password:"
    ieq RPASS,"DSOFT",RMENU
    e "Invalid Password."
    e ""
    p
    g chat3
    l whoiam3
    e "You are %SNAMME% (%username%)."
    e ""
    e "Everyone else is:"
    t "\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    e ""
    p
    g chat3
    ; ::CHATROOM 4 444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444444
    l 4
    af "","\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    af "user %SNAMME% is %username%","\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "%SNAMME% entered chat.","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    g chat4
    l chat4
    iex "\\E026060n01\room308\SERVER\ANONCHAT\BANS\%USERNAME%.txt",USERBAN
    cls
    e "Welcome to Chatroom D."
    e "Type /q to exit."
    e "type /r to refresh."
    e "type /whois to see who you are."
    e ""
    t "\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    e ""
    e "%SNAMME% in Chatroom D."
    stp MSG1,"Message:"
    ieq MSG1,"/r",chat4
    ieq MSG1,"/whois",whoiam4
    ieq MSG1,"/file",FILES4
    ieq MSG1,"/FILE",FILES4
    ieq MSG1,"/color",color14
    ieq MSG1,"/ROOT",RMENU24
    ieq MSG1,"/q",leave4
    e "SENDING..."
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "%SNAMME% said:","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "%MSG1%","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "%time% %date%","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    g chat4
    l leave4
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "%SNAMME% left!","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    g CCHOICE
    l color14
    clr 17
    g chat2
    l RMENU24
    stp RPASS,"Password:"
    ieq RPASS,"DSOFT",RMENU
    e "Invalid Password."
    e ""
    p
    g chat4
    l whoiam4
    e "You are %SNAMME% (%username%)."
    e ""
    e "Everyone else is:"
    t "\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    e ""
    p
    g chat4
    l WALL
    g main
    l funct
    cls
    e "What is funct?"
    e ""
    e ""funct" is short for function."
    e "in this chat program, there are some hidden"
    e "functions that do different things, such as clear"
    e "the chatroom, show the logged in users and time of"
    e "their login, as well as remove the chat server or program"
    e "software from the LAN. These short commands were programmed"
    e "into the software to make it easier for administrators to do"
    e "simple tasks without logging in as ROOT. some of these functions (The"
    e "latter two) Require special passcodes in order to function, to protect people"
    e "that rely on the chatroom for communication. the root passcode is "DSOFT", which"
    e "will let you view the current passcodes for the chat program."
    e ""
    e "How can i change the passcodes?"
    e ""
    e "Login as username ROOT."
    e "you will be promted to enter a password (DSOFT)"
    e "in the ROOT menu, select "1" (Change a passcode)"
    e "enter the old passcode."
    e "enter the new passcode."
    e "the program will tell you the status of the change,"
    e "then reload the root menu."
    e ""
    e "Who are administrators?"
    e ""
    e "Whoever installed the program. (Visible froom the ROOT menu)"
    e ""
    e "list:"
    e "   FUNCT1=CLEAR CHATROOM"
    e "   FUNCT2=SHOW ACESS LIST"
    e "   FUNCT3=COPY CHATROOM TO DESKTOP"
    e "   FUNCT004=DEL CHAT FROM NETWORK (NEED PASSCODE)"
    e "   FUNCT032=DEL ENTIRE SERVER (NEED PASSCODE)"
    e ""
    p
    g main
    l funct1
    cls
    e "            FUNCT1"
    e "Please choose a chatroom to clear:"
    e ""
    e "1)Chatroom A"
    e "2)Chatroom B"
    e "3)Chatroom C"
    e "4)Chatroom D"
    e "5)Exit"
    stp CROM,"Chatroom:"
    ieq CROM,"1",1CLS
    ieq CROM,"2",2CLS
    ieq CROM,"3",3CLS
    ieq CROM,"4",4CLS
    ieq CROM,"5",lf1
    e "Invalid chatroom."
    p
    g funct1
    l lf1
    ieq ROOT,"YES",RMENU
    g main
    l 1CLS
    ; unrecognized: attrib \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM.txt -h
    df "\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM.txt"
    af "[Chat refreshed at %time% %date%]","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM.txt"
    ; unrecognized: attrib \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM.txt +h
    e "Cleared"
    p
    g funct1
    l 2CLS
    ; unrecognized: attrib \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt -h
    df "\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt"
    af "[Chat refreshed at %time% %date%]","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt"
    ; unrecognized: attrib \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt +h
    e "Cleared"
    p
    g funct1
    l 3CLS
    ; unrecognized: attrib \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt -h
    df "\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    af "[Chat refreshed at %time% %date%]","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt"
    ; unrecognized: attrib \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt +h
    e "Cleared"
    p
    g funct1
    l 4CLS
    ; unrecognized: attrib \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt -h
    df "\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "[Chat refreshed at %time% %date%]","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    ; unrecognized: attrib \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM.txt +h
    e "Cleared"
    p
    g funct1
    l funct2
    e "FUNCT2 ENGAGED."
    e ""
    t "\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    e ""
    stp vpie,"Clear list? (Y/N)"
    ieq vpie,"Y",clr2
    ieq vpie,"y",clr2
    ieq vpie,"n",lf2
    ieq vpie,"N",lf2
    e "invalid."
    p
    g funct2
    l lf2
    ieq ROOT,"YES",RMENU
    g main
    l clr2
    ; unrecognized: attrib "\\E026060n01\room308\SERVER\ANONCHAT\names.txt" -h
    df "\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    af "[Cleared %time% %date%]","\\E026060n01\room308\SERVER\ANONCHAT\names.txt"
    ; unrecognized: attrib "\\E026060n01\room308\SERVER\ANONCHAT\names.txt" +h
    e "cleared."
    p
    g main
    l funct3
    cls
    e "            FUNCT3"
    e "Please choose a chatroom to copy:"
    e ""
    e "1)Chatroom A"
    e "2)Chatroom B"
    e "3)Chatroom C"
    e "4)Chatroom D"
    e "5)Exit"
    stp CROM,"Chatroom:"
    ieq CROM,"1",1CLS
    ieq CROM,"2",2CLS
    ieq CROM,"3",3CLS
    ieq CROM,"4",4CLS
    ieq CROM,"5",f3l
    e "Invalid chatroom."
    p
    g funct3
    l f3l
    ieq ROOT,"YES",RMENU
    g main
    l 1CLS
    e "Copying chatroom to desktop, please wait..."
    ; xcopy: xcopy \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM.txt %userprofile%\Desktop
    e "Copied."
    p
    g funct3
    l 2CLS
    e "Copying chatroom to desktop, please wait..."
    ; xcopy: xcopy \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM2.txt %userprofile%\Desktop
    e "Copied."
    p
    g funct3
    l 3CLS
    e "Copying chatroom to desktop, please wait..."
    ; xcopy: xcopy \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM3.txt %userprofile%\Desktop
    e "Copied."
    p
    g funct3
    l 4CLS
    e "Copying chatroom to desktop, please wait..."
    ; xcopy: xcopy \\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt %userprofile%\Desktop
    e "Copied."
    p
    g funct3
    l WALL
    g main
    l RMENU1
    stp RPASS,"Password:"
    ieq RPASS,"DSOFT",RMENU
    e "Invalid Password."
    e ""
    p
    g main
    l RMENU
    cls
    st ROOT,"YES"
    e "Root menu.     %time% %date%"
    e ""
    e ""
    e "Root options:"
    e "1)View a passcode"
    e "2)FUNCT QuickStart"
    e "3)Sysinfo"
    e "4)Banned users"
    e "5)Back up server to flashdisk."
    e "6)File options"
    e "7)Add an anouncement"
    e "8)Clear Chatroom"
    e "9)Clear Users"
    e "10)Copy a chatroom."
    e "11)Exit"
    e ""
    stp vpie,"COM:"
    ieq vpie,"1",CRPASS
    ieq vpie,"whoami",ROOTWHO
    ieq vpie,"2",QSFUNCT
    ieq vpie,"3",ROOTINF
    ieq vpie,"4",BANMAN
    ieq vpie,"5",SBACKUP
    ieq vpie,"6",FOPT
    ieq vpie,"7",AMNTS
    ieq vpie,"8",funct1
    ieq vpie,"9",funct2
    ieq vpie,"10",funct3
    ieq vpie,"11",main
    e "Command Is Invalid."
    p
    g RMENU
    l AMNTS
    cls
    e "Current Anouncements:"
    e ""
    t "\\E026060n01\room308\SERVER\\ANONCHAT\ADMIN\ANOUNCEMENTS.txt"
    e ""
    e "Type /q to exit."
    stp ACONT,"Anouncement:"
    ieq ACONT,"/q",RMENU
    ieq ACONT,"/Q",RMENU
    e "Processing, please wait..."
    af "","\\E026060n01\room308\SERVER\\ANONCHAT\ADMIN\ANOUNCEMENTS.txt"
    af "%time%/%date%:","\\E026060n01\room308\SERVER\\ANONCHAT\ADMIN\ANOUNCEMENTS.txt"
    af "%ACONT%","\\E026060n01\room308\SERVER\\ANONCHAT\ADMIN\ANOUNCEMENTS.txt"
    e "Finished!"
    e "Anouncement has been posted!"
    p
    g RMENU
    l FOPT
    cls
    e "File Options."
    e ""
    e "Please choose an option below:"
    e ""
    e "1)View Posts."
    e "2)View Downloads."
    e "3)Download a file"
    e "4)Exit"
    stp vpie,"File:"
    ieq vpie,"1",VPOSTS
    ieq vpie,"2",DPOSTS
    ieq vpie,"3",VDOWN
    ieq vpie,"4",RMENU
    e "Invalid."
    p
    g FOPT
    l VPOSTS
    cls
    e "File posts:"
    e ""
    t "\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\POSTS.txt"
    e ""
    p
    g FOPT
    l DPOSTS
    cls
    e "Downloads as of %time%/%date%:"
    e ""
    t "\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\DOWNLOADLIST.txt"
    e ""
    p
    g FOPT
    l VDOWN
    cls
    e ""
    e "Type "/q" in the name bar to return to"
    e "the main menu."
    e ""
    e "Posted files:"
    t "\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\POSTS.txt"
    e ""
    stp DFNAME,"File to download?"
    ieq DFNAME,"/q",FOPT
    iex "\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\%DFNAME%",RDOWNLOAD
    e "Oops! That file name is invalid!"
    e ""
    e "Check that the file name is correct."
    p
    g VDOWN
    l RDOWNLOAD
    cls
    e "Downloading file, please wait..."
    af "%SNAMME% (%username%) Downloaded a file: %DFNAME%.","\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\DOWNLOADLIST.txt"
    ; xcopy: xcopy \\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\%DFNAME% %userprofile%\Desktop >nul
    e "File was downloaded to Desktop successfully!"
    l RDYNMENU
    stp vpie,"Download another file? (Y/N)"
    ieq vpie,"y",VDOWN
    ieq vpie,"n",FOPT
    ieq vpie,"Y",VDOWN
    ieq vpie,"N",FOPT
    e "Command is invalid!"
    p
    g RDYNMENU
    l BANMAN
    cls
    e "Banned Users:"
