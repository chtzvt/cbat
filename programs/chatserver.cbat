    af "%SNAMME% (%username%) Downloaded a file: %DFNAME%. [%time%-%date%]","\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\DOWNLOADLIST.txt"
    ; xcopy: xcopy \\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\%DFNAME% %userprofile%\Desktop >nul
    e "File was downloaded to Desktop successfully!"
    l DYNMENU4
    stp vpie,"Download another file? (Y/N)"
    ieq vpie,"y",GETFILE4
    ieq vpie,"n",FILES4
    ieq vpie,"Y",GETFILE4
    ieq vpie,"N",FILES4
    e "Command is invalid!"
    p
    g DYNMENU4
    l SENDFILE4
    cls
    e "Drag the file you want to send on to the"
    e "Desktop, then press any key..."
    p 0
    cls
    e "Please type the name of the file, plus"
    e "its extension (.jpeg, .bat, .txt, etc...)"
    e "Type "/q" to exit."
    e ""
    stp FNAME,"File name (+ extension):"
    ieq FNAME,"/q",chat4
    iex "%USERPROFILE%\Desktop\%FNAME%",FILEISVALID4
    e "Oops! That file name is invalid!"
    e ""
    e "Check that the file is on the desktop,"
    e "and that the file name is correct."
    p
    g SENDFILE4
    l FILEISVALID4
    cls
    e "Would you like to add a message? (Y/N)"
    stp MSGYN,""
    ieq MSGYN,"y",MSGY4
    ieq MSGYN,"n",MSGN4
    ieq MSGYN,"Y",MSGY4
    ieq MSGYN,"N",MSGN4
    e "Command is invalid."
    p
    g FILEISVALID4
    l MSGY4
    cls
    e "Enter a message to send with your file:"
    stp FMSG,""
    g SENDAGENT4
    l MSGN4
    st FMSG,"Check out this cool file: %FNAME%!"
    g SENDAGENT4
    l SENDAGENT4
    cls
    e "Please wait while your file is being processed..."
    e ""
    ; xcopy: xcopy %USERPROFILE%\Desktop\%FNAME% \\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD >nul
    cls
    e "Posting to chatroom..."
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "%SNAMME% Posted a file! :","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "%FNAME%","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "Message:","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "%FMSG%","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "%time% %date%","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\CHATROOM4.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\POSTS.txt"
    af "%SNAMME% Posted a file! :","\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\POSTS.txt"
    af "%FNAME%","\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\POSTS.txt"
    af "Message:","\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\POSTS.txt"
    af "%FMSG%","\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\POSTS.txt"
    af "%time% %date%","\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\POSTS.txt"
    af "","\\E026060n01\room308\SERVER\ANONCHAT\DOWNLOAD\POSTS.txt"
    e "File Posted!"
    e "Press any key to return to chatroom..."
    g chat4
    l ODLAUNCHER
    cls
    e "Outdated launcher detected."
    ; malformed set: set "DETECTLAUNCHER" EQU "OUTDATED"
    c "\\E026060n01\room308\SERVER\SYSTEM\PLUGBOARD.bat"
    e "Program will now exit."
    p
    trm

.header
    filename "PLUGBOARD.bat"
    entry 0
    ver 1.0
.instrs
    ttl "SWITCHBOARD...STAGE 1...PROCESSING..."
    ; ::By Charlton Trezevant (DSOFT)
    ; ::Dial "0" for Operator.
    ; ::Install new features @ end
    ; ::last update: 3:46 PM 9/6/2012
    ; ::Version:
    st VERS,"1.0"
    g UPDATE
    st RAND,"%RANDOM%"
    st SBRAND,"%RAND%"
    ieq OP,"0",OP
    ieq DETECTLAUNCHER,"OUTDATED",UPDATE
    ieq SWITCH,"CHATA",LCHAT
    ieq SWITCH,"CHATB",LCHATB
    ieq SWITCH,"X-DOS",LXDOS
    ieq SWITCH,"FAILSAFE",FAILSAFE
    ieq SWITCH,"DMS",LDMS
    ieq SWITCH,"DMSB",LDMSB
    ; ::NUMERIC
    ieq NSWITCH,"100",LCHAT
    ieq NSWITCH,"101",LCHATB
    ieq NSWITCH,"200",LXDOS
    ieq NSWITCH,"FAIL1",FAILSAFE
    ieq NSWITCH,"300",LDMS
    ieq NSWITCH,"301",LDMSB
    ; ::Also numeric
    ieq SWITCH,"100",LCHAT
    ieq SWITCH,"101",LCHATB
    ieq SWITCH,"200",LXDOS
    ieq SWITCH,"FAIL1",FAILSAFE
    ieq SWITCH,"300",LDMS
    ieq SWITCH,"301",LDMSB
    l ERR
    e ""
    e "Could not identify request."
    e ""
    e "ERROR 244: Request not compatble. [%SWITCH%]"
    e "Encountered @ SWITHCHBOARD %VERS% Stage 1."
    e "Launcher version: %LVER%"
    e ""
    e "Your current launcher may not be compatible with the new EON server"
    e "Configuration."
    e ""
    af "ERROR 244: Request not compatble. [%SWITCH%]","%CD%\SERVER\SYSTEM\LOGS\ERRORS.txt"
    af "encountered @ SWITHCHBOARD %VERS% Stage 1.","%CD%\SERVER\SYSTEM\LOGS\ERRORS.txt"
    af "Launcher version: %LVER%","%CD%\SERVER\SYSTEM\LOGS\ERRORS.txt"
    af "User: %username%","%CD%\SERVER\SYSTEM\LOGS\ERRORS.txt"
    e ""
    g UPDATE
    l UPDATE
    stp vpie,"Attempt update? (Y/N):"
    ieq vpie,"y",UY
    ieq vpie,"n",END
    ieq vpie,"Y",UY
    ieq vpie,"N",END
    e "Invalid."
    p
    g UPDATE
    l UY
    cls
    e "The latest launcher will appear in your browser.."
    e "Please wait while the link loads..."
    ; ::ADD %s B4 %s to nullify the %s in URL for batch!!!
    ; ::start https:\\www.dropbox.com/sh/5617hvz24j0yqgd/QKcQSv7PMp/Chat%%21%%20Terminal.bat
    e "Press any key after you have downloaded the file."
    e "The program will copy the file to the desktop."
    p 0
    ; xcopy: xcopy "%CD%\UPDATE\Chat! Terminal.bat" "%USERPROFILE%\Desktop" /q /u >nul
    ; ::xcopy "%userprofile%\Downloads\Chat! Terminal.bat" "%USERPROFILE%\Desktop" /q /u >nul
    g USUCESS
    e "UPDATE FAILED."
    e ""
    g UPDATE
    l USUCESS
    st DETECTLAUNCHER,"OK"
    e "Please delete this launcher and use the new version,"
    e "located on the desktop."
    e ""
    e "THANK YOU!"
    g END
    l OP
    e "Version: %VERS%"
    e "User: %username%"
    e "ID rand: %SBRAND%"
    p
    g END0
    l LCHAT
    c "%CD%\SERVER\ANONCHAT\CHATSERVER.bat"
    g END
    l LDMS
    l LDMSB
    l LXDOS
    l LCHATB
    e ""
    e "Not installed."
    e "Please contact an Administrator."
    e ""
    l END
    e "Session closed."
    e "Program will now exit."
    p
    l END0
    e ""
    trm

