.header
    filename "svs.bat"
    entry 0
    ver 1.0
.instrs
    ; REM This is the saving system. You have to reset the autoload function to use it with the current save file.
    ; unrecognized: cd ..
    ; unrecognized: cd Saves
    iex "%curlod% del /F /S /Q %curlod%",
    ieq defined,"cosh",
    ieq defined,"emd",
    af "set ingame=no","%curlod%"
    ieq defined,"curlod",
    ; unrecognized: cd ..

