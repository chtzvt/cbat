    e "Please follow steps, when prompted."
    e "type "/q" in any propt to exit."
    e ""
    l unaa
    e "Desired Username:"
    stp UNAA,""
    ieq UNAA,"/q",X-DOS1
    ieq UNAA,"/Q",X-DOS1
    iex "%CD%\XSYS\USERS\%UNAA%-un.txt",ivunaa
    e "O.K."
    g passaa
    l ivunaa
    e "Username already taken!"
    p
    g register
    l passaa
    e "Desired Password:"
    stp PASSAA,""
    ieq PASSAA,"/q",X-DOS1
    ieq PASSAA,"/Q",X-DOS1
    e "Re-enter password:"
    stp PASSAA2,""
    ieq PASSAA2,"/q",X-DOS1
    ieq PASSAA2,"/Q",X-DOS1
    ieq PASSAA,"%PASSAA2%",rnaa
    e "Passwords don't match!"
    p
    g passaa
    l rnaa
    e "Real Name:"
    stp RNAA,""
    ieq RNAA,"/q",X-DOS1
    ieq RNAA,"/Q",X-DOS1
    l pinfo
    af "","%CD%\XSYS\USERS\%UNAA%-un.txt"
    af "%RNAA%","%CD%\XSYS\USERS\%UNAA%-un.txt"
    af "%UNAA%","%CD%\XSYS\USERS\%UNAA%-un.txt"
    af "%time%-%date%","%CD%\XSYS\USERS\%UNAA%-un.txt"
    af "on comp. acc %username%","%CD%\XSYS\USERS\%UNAA%-un.txt"
    af "","%CD%\XSYS\USERS\%UNAA%-%PASSAA%-login.txt"
    af "%RNAA%","%CD%\XSYS\USERS\%UNAA%-%PASSAA%-login.txt"
    af "%UNAA%","%CD%\XSYS\USERS\%UNAA%-%PASSAA%-login.txt"
    af "%time%-%date%","%CD%\XSYS\USERS\%UNAA%-%PASSAA%-login.txt"
    af "on comp. acc %username%","%CD%\XSYS\USERS\%UNAA%-%PASSAA%-login.txt"
    ; ::for admins
    af "","%CD%\XSYS\USERS\LOGIN.txt"
    af "%time%-%date%","%CD%\XSYS\USERS\LOGIN.txt"
    af "%UNAA% | %PASSAA%","%CD%\XSYS\USERS\LOGIN.txt"
    af "%RNAA%","%CD%\XSYS\USERS\LOGIN.txt"
    e "Registration Complete!"
    e "You will be redirected to the login screen..."
    p
    g X-DOS1
    l noreg
    e "Registration disabled by ADMIN."
    p
    ieq LOGIN,"YES",P
    g X-DOS1
    l noboot
    e "Boot menu disabled by ADMIN."
    ieq LOGIN,"YES",P
    p
    g X-DOS1

