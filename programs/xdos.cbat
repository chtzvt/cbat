.global
    entry "X-DOS.bat"

.header
    filename "X-DOS.bat"
    entry 0
    ver 1.0
.instrs
    l X-DOS1
    st VERSION,"5.5"
    ; ::CHANGELOG
    ; ::3:27 PM 9/8/2012 Added major improvements.
    ; ::2:03 PM 9/22/2012 Final improvements made to 5.0
    ttl "X-DOS v%VERSION%"
    st YNREG,"Yes"
    clr 17
    cls
    l AUTO
    iex "%CD%\XSYS\SYSTEM\MODE\AUTOMATICLOGIN.txt",SETLOGIN
    g up
    l SETLOGIN
    e "You are being automatically logged in..."
    slp 0
    st user,""
    st pass,""
    stf user,"%CD%\XSYS\SYSTEM\AUTOLOGIN.txt"
    iex "%CD%\XSYS\USERS\%user%-un.txt",goodAL1
    e "The AutoLogin credentials are invalid."
    p
    g up
    l goodAL1
    stf pass,"%CD%\XSYS\SYSTEM\AUTOLOGINP.txt"
    iex "%CD%\XSYS\USERS\%user%-%pass%-login.txt",good
    e "The AutoLogin credentials are invalid."
    p
    g up
    l up
    clr 17
    cls
    ttl "Log in to X-DOS."
    e "Log in to X-DOS."
    e ""
    e "Type "options" for options."
    e ""
    stp user,"username:"
    ieq user,"newuser",register
    ieq user,"SETTINGS",opu
    ieq user,"options",opmen
    ieq user,"boot",bootmenu
    ieq user,"smode",smodelodr
    iex "%CD%\XSYS\USERS\%user%-un.txt",gooduser
    e "Invalid username."
    p
    g up
    l smodelodr
    iex "%CD%\XSYS\SYSTEM\MODE\NOSMODE.txt",nosmode
    e "LOADING SAFE MODE..."
    e "Please wait..."
    g SAFE-MODE
    l opmen
    e "Type "boot" for boot options,"
    e "or "newuser" to make an account."
    e "Alternatively, you can log in as "smode""
    e "to boot into safe mode."
    e "Commab"
    e ""
    e "All of these commands may be enabled or"
    e "disabled by your administrator at any time."
    p
    g up
    l bootmenu
    iex "%CD%\XSYS\SYSTEM\MODE\NOBOOT.txt",noboot
    cls
    clr 07
    e "Please select a boot option:"
    e "1)Command prompt only."
    e "2)Safe mode only."
    e "3)Restart this machine."
    e "4)Exit to login."
    stp input,":"
    ieq input,"1",234432
    ieq input,"2",smodemain
    ieq input,"3",bootrestart
    ieq input,"4",up
    e "Command invalid."
    p
    g bootmenu
    l 234432
    cls
    c "cmd.exe"
    trm
    l bootrestart
    ; unrecognized: shutdown/f
    l gooduser
    stp pass,"password:"
    ieq pass,"dave",good
    ieq pass,"@@",good
    iex "%CD%\XSYS\USERS\%user%-%pass%-login.txt",good
    e "invalid login."
    e "Press any key to exit..."
    af "","%CD%\XSYS\SYSTEM\elogonrecord.txt"
    af "An unauthorized user logged on at %time% on %date%","%CD%\XSYS\SYSTEM\elogonrecord.txt"
    af "","%CD%\XSYS\SYSTEM\elogonrecord.txt"
    g up
    l good
    ttl "X-DOS v%VERSION%"
    af "","%CD%\XSYS\SYSTEM\logonrecord.txt"
    af "%user% logged on at %time% on %date%","%CD%\XSYS\SYSTEM\logonrecord.txt"
    cls
    e "Loading-Please wait [1%%]"
    cls
    e "Loading-Please wait [2%%]"
    cls
    e "Loading-Please wait [3%%]"
    cls
    e "Loading-Please wait [4%%]"
    cls
