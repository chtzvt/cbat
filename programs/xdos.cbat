    e "                         [%a2%] [%b2%] [%c2%] [%d2%] [%e2%] [%f2%]"
    e "                      {*}                       {*}"
    e "                      {%s2%}        MANCALA        {%s1%}"
    e "                      {*}                       {*}"
    e "                         [%a1%] [%b1%] [%c1%] [%d1%] [%e1%] [%f1%]"
    e ""
    e "                          A   B   C   D   E   F"
    e ""
    e "                                                   %p1%"
    e "Extra Turn!!!"
    e ""
    g p1
    l map2
    cls
    e ""
    e ""
    e "                         Score: %p1%: %p1s%"
