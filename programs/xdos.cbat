.header
    filename "SP2.bat"
    entry 0
    ver 1.0
.instrs
    ttl "Mancala by William"
    clr 02
    l titlescreen
    clr 0A
    e ""
    e ""
    e ""
    e "                               *****************************************"
    e ""
    e "                                 ##   ##"
    e "                                 ### ###                       #"
    e "                                 ## # ## ####  #### #### ####  # ####"
    e "                                 ##   ## #  #  #  # #    #  #  # #  #"
    e "                                 ##   ## ### # #  # #### ### # # ### #"
    e ""
    e "                               *****************************************"
    e ""
    e "                                                           By William"
    e ""
    e "1) Play Game"
    e "2) Instructions"
    e "3) Exit"
    e ""
    stp v,""
    ieq v,"1",:superstart
    ieq v,"2",:instruct
    ieq v,"3",finend
    e ""
    l instruct
    cls
    e ""
    e ""
    e "Welcome to Mancala By William. The goal of the game is to get the"
    e "most "stones" into your side slots. There aren't any stones in"
    e "this game like a normal Mancala set, however, the amount of"
    e "stones is represented by a number in the correct slot. To move"
    e ""stones" type in the column you wish to move (lowercase only)."
    e "At the end, the person with the most amount of stones in their"
    e "side slot wins. The end of the game is when all stones are in"
    e "one of the side pockets. BTW, I do not claim to own Mancala,"
    e "this is just my representation of the game. First Player is"
    e "on the bottom, and moves to the right. Second Player is on"
    e "the top and moves to the left. You receive an extra turn if your"
    e "last "stone" lands in your side slot."
    e ""
    p
    l superstart
    cls
    sta p1s,"0"
    sta p2s,"0"
    sta draw,"0"
    e ""
    e ""
    e "Who is Player 1?"
    e ""
    stp p1,""
    e ""
    cls
    e ""
    e ""
    e "Who is Player 2?"
    e ""
    stp p2,""
    e ""
    cls
    l start
    sta s1,"0"
    sta s2,"0"
    sta a1,"4"
    sta a2,"4"
    sta b1,"4"
    sta b2,"4"
    sta c1,"4"
    sta c2,"4"
    sta d1,"4"
    sta d2,"4"
    sta e1,"4"
    sta e2,"4"
    sta f1,"4"
    sta f2,"4"
    l map1
    cls
    e ""
    e ""
    e "                         Score: %p1%: %p1s%"
    e "                                %p2%: %p2s%"
    e "                                Draw: %draw%"
    e ""
    e "                  %p2%"
    e ""
    e "                          A   B   C   D   E   F"
    e ""
    e "                         [%a2%] [%b2%] [%c2%] [%d2%] [%e2%] [%f2%]"
    e "                      {*}                       {*}"
    e "                      {%s2%}        MANCALA        {%s1%}"
    e "                      {*}                       {*}"
    e "                         [%a1%] [%b1%] [%c1%] [%d1%] [%e1%] [%f1%]"
    e ""
    e "                          A   B   C   D   E   F"
    e ""
    e "                                                   %p1%"
    e ""
    g P1
    l map1extra
    cls
    e ""
    e ""
