    ; unrecognized: echo/ %displayline13:#=!%
    ; unrecognized: echo/ %displayline14:#=!%
    ; unrecognized: echo/ %displayline15:#=!%
    ; unrecognized: echo/ %displayline16:#=!%
    ; unrecognized: echo/ %displayline17:#=!%
    ; unrecognized: echo/ %displayline18:#=!%
    ; unrecognized: echo/ %displayline19:#=!%
    ; unrecognized: echo/ %displayline20:#=!%
    ; unrecognized: echo/ %displayline21:#=!%
    ; unrecognized: echo/ %displayline22:#=!%
    ; unrecognized: echo/ %displayline23:#=!%
    ; unrecognized: echo/ %displayline24:#=!%
    trm
    l SwapOrNot
    cls
    e ""
    e "              ####################################"
    e "             ##                                  ##"
    e "            ##    ############################    ##"
    e "             ######     ##            ##     ######"
    e "                     ######################"
    e "                     #######        #######"
    e "                     #####            #####"
    e "                     ####              ####"
    e "                     ####              ####"
    e "                     #####            #####"
    e "                    #######          #######"
    e "                   ##########################"
    e "                  ############################"
    e "                 ##############################"
    e "                ################################"
    e ""
    e ""
    e "               The Banker Has Offered You The Swap"
    e ""
    e ""
    e "                       SWAP OR NO SWAP?"
    l SwapOrNoSwap
    st swap,""
    stp Swap,""       ""
    inq defined,"Swap",SwapOrNoSwap
    ieq /i %Swap:~0,1%,"S",
    ieq /i %Swap:~0,1%,"N",
    l Swap_Not_Taken
    ; unrecognized: for /f "tokens=1,2 delims=," %%I in ("%AmountsLeft%") do if /i "%%I"=="!Box%OwnBox%!" (set Offer=!Amount%%I!& set OtherBox=%%J& Set OwnBox=%%I) else (set offer=!Amount%%J!& set OtherBox=%%I&& Set OwnBox=%%J)
    ieq /i,"%offer%",
    sta offer,"%offer% / 100"
    ieq /i,"%Offer%",
    g SwapResult
    l Swap_Taken
    ; unrecognized: for /f "tokens=1,2 delims=," %%I in ("%AmountsLeft%") do if /i "%%I"=="!Box%OwnBox%!" (set Offer=!Amount%%J!& set OtherBox=%%I& Set OwnBox=%%J) else (set offer=!Amount%%I!& set OtherBox=%%J& Set OwnBox=%%I)
    ieq /i,"%offer%",
    sta offer,"%offer% / 100"
    ieq /i,"%Offer%",
    l SwapResult
    ieq /i,"%OwnBox%",
    e "You took the chance and won :D Well done"
    ; unrecognized: ) else (
    e "Hard luck, you got the smaller prize."
    ; unrecognized: )
    e "You won $%Offer% :)"
    p 0
    g endofgame
    l Deal_Taken
    st dealdone,"1"
    ieq /i,"%Offer%",
    ieq /i,"%offer%",
    st Newoffer,"0.%offer%"
    ; unrecognized: ) else (
    st Newoffer,"%offer%"
    ; unrecognized: )
    st temp,"!Box%ownbox%!"
    ieq /i,"!Amount%temp%!",
    st Newtemp,"0.!Amount%temp%!"
    ; unrecognized: ) Else (
    sta Newtemp,"!Amount%temp%! / 100"
    ; unrecognized: )
    ieq /i,"%newtemp:.=%",
    e "Hard luck, in your box there was $%newtemp%, but you dealed at $%Newoffer%"
    ; unrecognized: )
    ieq /i,"%newtemp:.=%",
    e "Well done, you beat the banker :D"
    e "Your box was worth $%newtemp% but you sold it for $%NewOffer%"
    ; unrecognized: )
    ieq /i,"%newtemp:.=%",
    e "You managed to sell your box for exactly what it was worth, well done :D"
    e "You won $%NewOffer% :)"
    ; unrecognized: )
    p 0
    g EndOfGame
    l BigWin
    cls
    e "#######################################################"
    e "#                                                     #"
    e "#                                                     #"
    e "#   @       @   @   @   @   @   @   @@@@   @@@@   @   #"
    e "#   @       @   @   @@  @   @@  @   @      @   @  @   #"
    e "#   @       @   @   @ @ @   @ @ @   @      @  @   @   #"
    e "#   @   @   @   @   @ @ @   @ @ @   @@@    @@@    @   #"
    e "#   @  @ @  @   @   @ @ @   @ @ @   @      @  @   @   #"
    e "#   @ @   @ @   @   @ @ @   @ @ @   @      @   @      #"
    e "#    @     @    @   @  @@   @  @@   @@@@   @   @  @   #"
    e "#                                                     #"
    e "#                                                     #"
    e "#######################################################"
    e ""
    e ""
    trm
    l endOfGame
    l finend

.header
    filename "SK1.bat"
    entry 0
    ver 1.0
.instrs
    clr 0a
    ttl "setup"
    e "             Thank you for chosing Batch Generation Computing's"
    e ""
    e "             Xtrodinary Differential Output System v1.0 (X-DOS)"
    e ""
    p
    cls
    e "                           Created By:"
    e ""
    e "                           David Dodge"
    e ""
    p
    cls
    e "                        Including Code By:"
    e ""
    e "         William from www.higginsbatch.webs.com"
    e ""
    e "     ScrewTheLotOfYou from www.screwthelotofyou.webs.com"
    e ""
    e "       abs1296 from www.sites.google.com/site/absppt"
    e ""
    e "                       schoolhacks"
    e ""
    p
    cls
    e "Welcome to the world of command prompt, somthing that is on every"
    e "windows computer, but many people do not take advantage of this"
    e "powerful little program on windows.Since X-DOS runs in"
    e "command prompt, here is a tuturial of how to use the program."
    e ""
    p
    cls
    e "If you you are reading this, you already know what to do if"
    e "it says "press any key to continue". If the computer appears to"
    e "just be sitting there press any key to continue with that to."
    e "Note that if that does not do anything do not do anything as the"
    e "computer is thinking."
    p
    cls
    e "If the program needs you to input something, input the option"
    e "you want ( either a number or yes/no) and press the enter key."
    e "options have to be entered in lowercase."
    p
    cls
    e "The program has you enter a username and password. To find the"
    e "avalible user accounts please refer to the instructions that"
    e "came with the program."
    p
    cls
    e "To use the message service of X-DOS, Follow the instructions"
    p
    cls
    e "1) goto the start menu and right click my computer"
    e ""
    e "2) click manage, it will bring up a new window"
    e ""
    e "3) double click "services and applications""
    e ""
    e "4) double click "services""
    e ""
    e "5) The services are in alphibetical order, look for "messanger""
    e ""
    e "6) If it says "automatic" next to it, then you don't have to do anything"
    e ""
    e "7) If it says "disabled" then right click it, click properties, and select"
    e "   "automatic" in the drop down box. Click apply, then let it start up."
    e ""
    p
    cls
    e "To use the movie and internet features, you must have internet access."
    p
    cls
    e "                            File Setup"
    e ""
    e "Right click the BG-Computing c folder and click copy. Then"
    e "goto where you want the folder, right click, and click paste."
    p
    cls
    e "Open the BG computing folder and drag and drop the tree icon"
    e "onto your desktop."
    p
    cls
    e "Do Not move any other files"
    e ""
    p
    cls
    e "The help icon will open help and the setup icon will open this."
    e "The tree icon opens the program."
    p
    cls
    e "Continuing will open the help file. I hope you enjoy X-DOS v1.0"
    p
    ; unrecognized: start SK2.bat
    trm

.header
    filename "SK2.bat"
    entry 0
    ver 1.0
.instrs
    ttl "help"
    clr 0a
    l U
    cls
    e "What do you want to do?"
    e ""
    e "1) errors"
    e "2) FAQ"
    e ""
    stp opl,""
    ieq opl,"1",3
    cls
    e "************************************************************"
    e "*                 Frequently Asked Questions               *"
    e "*                                                          *"
    e "************************************************************"
    e ""
    e "Q: What are all those files in the BG computing folder?"
    e ""
    e "A: These are system files that the program needs to run,"
    e "   DO Not move,rename, modify these files in any way or"
    e "   else the program will malfuction. In other words, any"
    e "   file that has a folder,gear, or slot machine looking icon"
    e "   you should not be messing with!"
    e ""
    e "Q: What is the file named logonrecord.txt?"
    e ""
    e "A: This is a useful feature of X-DOS that will"
    e "   log who logs on and when. To see the log,"
    e "   open logonrecord.txt. Note that you have to"
    e "   have run X-DOS once to have logonrecord.txt"
    e ""
    e "Q: What is the credits?"
    e ""
    e "A: The people in the credits are the people who"
    e "   I got games and ideas from online."
    e ""
    e "Q: What X-DOS stand for?"
    e ""
    e "A: Xtrdainary Differential Output System"
    e "   I named it that because it sounds cool"
    e ""
    e "Q: How do I use the message feture?"
    e ""
    e "A: For user type the computer's IP address,"
    e "   or an * to send the message to all computers"
    e "   on your network."
    p
    g U
    l 3
    e "                          Errors"
    e ""
    e "   Message pops up saying "Windows cannot find (filename)""
    e ""
    e "   solution: Reinstall X-DOS"
    e ""
    e "   If anything else happens, please contact BG computing"
    e ""
    p
    g U

