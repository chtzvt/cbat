.header
    filename "fae.bat"
    entry 0
    ver 1.0
.instrs
    l gnfe
    e ""
    e " ษอออออออออออออออออออป"
    e " บ    FATAL ERROR    บ"
    e " ศอออออออออออออออออออผ"
    p 0

.header
    filename "qna.bat"
    entry 0
    ver 1.0
.instrs
    ; unrecognized: cd ..
    cls
    e " ษอออออออออออออออออออหอออออออออออออออออออออออหออออออออป"
    e " บ 777 LAS VEGAS 777 บ Questions and Answers บ Page 1 บ"
    e " ศอออออออออออออออออออสอออออออออออออออออออออออสออออออออผ"
    e ""
    e " Q: The game didn't save my progress. Why?"
    e " A: The game doesn't save your progress automatically, you have to save it from"
    e "    the main menu. However, the autoload function's saved automatically. There"
    e "    are some errors in the saving system, I'm working on it."
    e ""
    e " Q: Why doesn't the game let me pull the arm?"
    e " A: Try to insert more than 50 $ (use INS)"
    e ""
    e " Q: Why doesn't the game display my score?"
    e " A: You have to win some money. If the money's in the machine, use GIVE to get"
    e "    your prize."
    e ""
    e " Q: What are these files in the game directory?"
    e " A: In the Saves folder there are your saved games and in the System folder"
    e "    there are system files. If you modfy them, the game may crash."
    e ""
    e " Q: What is Simple mode and Autoload?"
    e " A: Simple mode disables animations and Autoload loads the current saved game"
    e "    when you start the game."
    p 0
    cls
    e " ษอออออออออออออออออออหอออออออออออออออออออออออหออออออออป"
    e " บ 777 LAS VEGAS 777 บ Questions and Answers บ Page 2 บ"
    e " ศอออออออออออออออออออสอออออออออออออออออออออออสออออออออผ"
    e ""
    e " Q: How to get help in game?"
    e " A: Type HELP."
    e ""
    e " Q: Why can't I keep more fields?"
    e " A: You can only keep 2 fields. Use UNKEEP to disable KEEP and use it again."
    e ""
    e " Q: What is the ERROR message on the machine?"
    e " A: It's usually not a system error. Try to figure what did you do wrong."
    e "    The HELP command is usually very useful. However sometimes the ERROR"
    e "    message is a real system error."
    e ""
    e " Q: I know batch programming language. Is there something interesting for me?"
    e " A: There's a debug menu in the game. Use the "debug" command in the main menu."
    e ""
    e " Q: My question isn't here. What can I do?"
    e " A: You can use the help screen (HELP), read this again and you can can send"
    e "    me a message at YouTube (Name: ABS1296)"
    p 0

