    e "Loading-Please wait [98%%]"
    cls
    e "Loading-Please wait [99%%]"
    cls
    e "Loading-Please wait [100%%]"
    p
    l A
    st LOGIN,"YES"
    ttl "X-DOS v%VERSION% (%user%'s session.)"
    cls
    clr 17
    st input,""
    ieq user,"exit",up
    e "X-DOS Version %VERSION%."
    e "Created by DSOFT."
    e "Type "?" for help."
    e "%time%-%date%"
    e ""
    e ""
    g P
    l clsp
    cls
    l P
    st input,""
    stp input,"X-DOS:%user%$>"
    ieq input,"games",1
    ieq input,"message",2
    ieq input,"movie",3
    ieq input,"calculator",4
    ieq input,"internet",5
    ieq input,"music",6
    ieq input,"logoff",7
    ieq input,"time",8
    ieq input,"?",45
    ieq input,"exit",77
    ieq input,"generators",789987
    ieq input,"credits",707
    ieq input,"terminal",cmdprpt
    ieq input,"shell",cmdprpt
    ieq input,"cmd",cmdprpt
    ieq input,"scribe",scribe
    ieq input,"word",scribe
    ieq input,"sleep",sleepmode
    ieq input,"help",45
    ieq input,"mail",DMS
    ieq input,"message",DMS
    ieq input,"",Pa
    ieq input," ",Pa
    ieq input,"clear",clsp
    ieq input,"cls",clsp
    ieq input,"start",SX
    ieq input,"whoami",whoiam
    ieq input,"clock",8
    ieq input,"chat",chata
    ieq input,"relay",chata
    ieq input,"vers",versinfo
    ieq input,"xsys",xsysinfo
    ieq input,"ipaddr",ipaddr
    ieq input,"smode",SAFE-MODE
    ieq input,"SETTINGS",opu
    ieq input,"newuser",register
    ieq input,"bootmenu",bootmenu
    e "Invalid command "%input%"."
    e "Type ? for a list."
    e ""
    g P
    l ipaddr
    ; unrecognized: ipconfig
    g P
    l xsysinfo
    e " User.....................%user%"
    e " Version..................%VERSION%"
    e " Checking update data............."
    e "Last update:"
    t ""%CD%\XSYS\SYSTEM\UPDATEINFO.txt"
    e ""
    e ""
    e ":::::CHECK SYSTEM COMPONENTS:::::"
    e "Checking system................."
    iex ""%CD%\XSYS" echo [1/3] System files OK!",
    iex ""%CD%\XSYS\SYSTEM" echo [2/3] Underlying system structure OK!",
    iex ""%CD%\XSYS\PROGRAMS" echo [3/3] Program folder OK!",
    e "!! Preparing to check installed programs..."
    iex ""%CD%\XSYS\PROGRAMS\LLOTTO" echo [1/18] Lucky lotto system files OK!",
    iex ""%CD%\XSYS\PROGRAMS\Saves" echo [2/18] Game Part 1 Las Vegas 777 system OK!",
    iex ""%CD%\XSYS\PROGRAMS\System" echo [3/18] Game Part 2 Las Vegas 777 system OK!",
    iex ""%CD%\XSYS\PROGRAMS\cmd.exe" echo [4/18] Command-Line OK!",
    iex ""%CD%\XSYS\PROGRAMS\HITCHHIK.dat" echo [5/18] Game Hitchhiker's Guide system files OK!",
    iex ""%CD%\XSYS\PROGRAMS\HITCHHIK.exe" echo [6/18] Game Hitchhiker's Guide OK!",
    iex ""%CD%\XSYS\PROGRAMS\msg.exe" echo [7/18] Messenger OK!",
    iex ""%CD%\XSYS\PROGRAMS\SK1.bat" echo [8/18] Old setup OK!",
    iex ""%CD%\XSYS\PROGRAMS\SK2.bat" echo [9/18] Old FAQ OK!",
    iex ""%CD%\XSYS\PROGRAMS\SK09.bat" echo [10/18] Game T-T-T OK!",
    iex ""%CD%\XSYS\PROGRAMS\SK84.bat" echo [11/18] Game Connect-4 OK!",
    iex ""%CD%\XSYS\PROGRAMS\SP1.bat" echo [12/18] Game Genius OK!",
    iex ""%CD%\XSYS\PROGRAMS\SP2.bat" echo [13/18] Game Mancala OK!",
    iex ""%CD%\XSYS\PROGRAMS\SP3.bat" echo [14/18] Game R.P.S OK!",
    iex ""%CD%\XSYS\PROGRAMS\SP4.bat" echo [15/18] Calculator OK!",
    iex ""%CD%\XSYS\PROGRAMS\SP5.exe" echo [16/18] Game Las Vegas 777 OK!",
    iex ""%CD%\XSYS\PROGRAMS\SP6.bat" echo [17/18] Matrix OK!",
    iex ""%CD%\XSYS\PROGRAMS\SP7.bat" echo [18/18] Game Deal or no Deal OK!",
    e "!! XSYS check complete!"
    e ""
    g P
    l versinfo
    e "X-DOS version %VERSION%."
    e "Created by DSOFT."
    e ""
    e "Last update:"
    t ""%CD%\XSYS\SYSTEM\UPDATEINFO.txt"
    e ""
    g P
    l chata
    cls
    e "Starting Chat..."
    iex "\\E026060n01\room308\SERVER",bnetchat
    ; unrecognized: telnet relay.zapto.org
    e "Press any key to go Home..."
    p 0
    g P
    l bnetchat
    e "BISD Network detected!"
    st SWITCH,"CHATA"
    st NSWITCH,"100"
    c "\\E026060n01\room308\SERVER\SYSTEM\PLUGBOARD.bat"
    p
    g P
    l whoiam
    e "%user%"
    g P
    l SX
    ; unrecognized: start X-DOS.bat
    g P
    l Pa
    g P
    l interpreter
    e "No longer available since 5.5"
    g P
    l sleepmode
    cls
    e "                 Program in sleep mode."
    e "            [%time%] [%date%]"
    e ""
    p 0
    g redirect
    l redirect
    cls
    g P
    l DMS
    cls
    e "Starting Mail..."
    iex "\\E026060n01\room308\SERVER",bnetDMS
    ; unrecognized: telnet dsoft.zapto.org
    e "Press any key to go Home..."
    p 0
    g P
    l bnetDMS
    e "BISD Network detected!"
    st SWITCH,"DMS"
    c "\\E026060n01\room308\SERVER\SYSTEM\PLUGBOARD.bat"
    p
    g P
    l cmdprpt
    e "running command prompt"
    ; unrecognized: start "%CD%\XSYS\PROGAMS\cmd.exe"
    p
    g redirect
    l 1
    cls
    clr 17
    e "games:"
    e "1) tic-tac-toe"
    e "2) connect 4"
    e "3) genius"
    e "4) mancala"
    e "5) rock-papper-scissors"
    e "6) Las-Vagas 777"
    e "7) deal or no deal"
    e "8) ---"
    e "9) super mario bros. 3D"
    e "10) Hitchhiker's Guide"
    e "11) main menu"
    e ""
    e "What would you like to play?"
    stp spie,"X-DOS:%user%$>"
    ieq spie,"1",TtT
    ieq spie,"2",22
    ieq spie,"3",33
    ieq spie,"4",44
    ieq spie,"5",55
    ieq spie,"6",679
    ieq spie,"7",660
    ieq spie,"8",1
    ieq spie,"9",
    ieq spie,"10",2233
    ieq spie,"11",66
    e "Command Invalid."
    p
    g 1
    l 22
    cls
    e "Running CONNECT-4"
    c "%CD%\XSYS\PROGRAMS\SK84.bat"
    p
    g 1
    l TtT
    cls
    c "%CD%\XSYS\PROGRAMS\SK09.bat"
    p
    g 1
    l 2233
    cls
    c "%CD%\XSYS\PROGRAMS\HITCHHIK.EXE"
    e "Running "Hitchhiker's Guide"
    e "Press any key to continue..."
    ; unrecognized: pause<nul
    g 779
    l 33
    cls
    c "%CD%\XSYS\PROGRAMS\SP1.bat"
    e "Running Genius"
    p
    g P
    l 44
    cls
    c "%CD%\XSYS\PROGRAMS\SP2.bat"
    e "Running manacala"
    p
    g P
    l 55
    cls
    c "%CD%\XSYS\PROGAMS\SP3.bat"
    e "Running r.p.s."
    p
    g P
    l 66
    g P
    l 2
    cls
    e "MESSENGER"
    stp n,"User:"
    stp m,"Message:"
    cls
    ; unrecognized: "%CD%\XSYS\PROGRAMS\msg.exe" %n% %m%
    e "Loading"
    e "What would you like to do?"
    e ""
    e "To use messenger, enter an asterisk in "user" then enter message."
    e ""
    e "1) send another message"
    e "2) main menu"
    e ""
    stp ujkl,""
    ieq ujkl,"1",2
    ieq ujkl,"2",P
    ieq ujkl,"!",4734
    e "Command Invalid."
    e "Type ? for a list."
    p
    g 2
    l 3
    cls
    e "star wars movie"
    clr 17
    stp n,"hit enter to connect to server"
    stp m,"hit enter to watch movie"
    ; unrecognized: telnet towel.blinkenlights.nl
    stp o,"thank you for watching"
    p
    g P
    l 4
    cls
    c "%CD%\XSYS\PROGRAMS\SP4.bat"
    e "Running calculator"
    p
    g P
    l 5
    cls
    e "Internet menu"
    e ""
    e "1) google"
    e "2) Reddit"
    e "3) main menu"
    e ""
    stp upie,""
    ieq upie,"1",45675
    ieq upie,"2",RED.DIT
    ieq upie,"3",7743
    ieq upie,"4",4734
    l RED.DIT
    cls
    e "LOADING..."
    ; unrecognized: start www.reddit.com
    cls
    e "running reddit"
    p
    g P
    l 45675
    cls
    e "LOADING..."
    ; unrecognized: start www.google.com
    cls
    e "running internet"
    p
    g P
    l 7743
    g P
    l 6
    cls
    ; unrecognized: start wmplayer.exe
    p
    g P
    l 7
    cls
    e "Log Off? (yes/no)"
    stp ypie,""
    ieq ypie,"yes",up
    ieq ypie,"no",P
    ieq ypie,"!",4734
    e "Invalid."
    g P
    l LLKJ
    af "%user% logged off at %time% on %date%","%CD%\XSYS\USERS\logonrecord.txt"
    g up
    l 8
    e "Mr.Clock says:"
    e ""
    e "                          ||||||||||||||||||||||||||||||||"
    e "                              ------           ------"
    e "                                ()               ()"
    e "                                         /\"
    e "                                        /  \"
    e "                                        ----"
    e "                                  ================"
    e "                           [%time%] [%date%]"
    e "                                  ================"
    e "                                         \/"
    p
    g P
    l 45
    cls
    e "/ separates commands with the same outcome."
    e "COMMANDS ARE CASE SENSITIVE! ALL ARE IN LOWER CASE!"
    e "all commands:"
    e "command   !output"
    e "----------!--------"
    e "games     !goto games"
    e "message   !goto mesenger"
    e "movie     !plays movie"
    e "calculator!goto calculator"
    e "internet  !goto internet"
    e "music     !goto meadia player"
    e "logoff    !logs off"
    e "time/clock!displays the time"
    e "help      !displays help"
    e "exit      !exits"
    e "generators!goto generator menu"
    e "credits   !goto credits"
    e "cmd       !starts command prompt"
    e "terminal  !starts command prompt"
    e "sleep     !sleeps program"
    e "DMS       !Starts the Dynamic Messaging System"
    e "relay     !Starts Chat"
    e "clear/cls !Clears prompt"
    e "start     !Starts a new instance of X-DOS"
    e "vers      !Version information"
    e "xsys      !X-DOS system information"
    e "ipaddr    !Internet Protocol information."
    e "newuser   !Register new user (You will be logged out)"
    e "bootmenu  !Boot menu (You will be logged out)"
    e "smode     !Safe Mode (You will be logged out)"
    e "SETTINGS  !Administrator settings"
    e ""
    e ""
    g P
    l 77
    cls
    e "Are you sure you want to exit?"
    e "Typing "logoff" will take you"
    e "to the login screen"
    stp rpie,""
    ieq rpie,"yes",458
    ieq rpie,"no",779
    ieq rpie,"back",up
    ieq RPIE,"!",
    ieq rpie,"logoff",up
    l 4734
    ttl "SELF DESTRUCT"
    clr 0c
    cls
    g up
    l qwertyuiop
    e "Continuing will delete all files and folders associated with [X-DOS]"
    e "Deleted files cannot be recovered."
    e "are you sure you want to proceed?"
    e ""
    e "1)Y"
    e "2)N"
    stp input,"command:"
    ieq input,"1",imp22
    ieq input,"2",bluewire
    e "Invalid Command"
    p
    g qwertyuiop
    l imp22
    e "deleting [X-DOS]"
    e "Please wait..."
    df "%CD%\XSYS\"
    e "Wipe complete."
    e "Press any key to finish wipe..."
    p 0
    df "%CD%\X-DOS.bat"
    trm
    l bluewire
    e "For security reasons, You will"
    e "be logged off."
    l 458
    af "%user% logged off at %time% on %date%","%CD%\XSYS\USERS\logonrecord.txt"
    trm
    l 779
    g P
    l 789987
    cls
    e "1) random number generator"
    e "2) password generator"
    e "3) lottery number generator"
    e "4) main menu"
    e ""
    stp ipie,""
    ieq ipie,"1",908
    ieq ipie,"2",907
    ieq ipie,"3",9068
    ieq ipie,"4",P
    ieq ipie,"!",4734
    l 908
    cls
    e "Random number:"
    e "%random%%random%"
    p
    g 789987
    l 907
    l start90
    st pass,""
    sta done,"0"
    cls
    e ""
    e ""
    e "Press any key to begin Password Generation..."
    e ""
    e ""
    p 0
    cls
    e ""
    e ""
    e "How many characters do you want it to be?"
    e ""
    stp num,""
    cls
    l numorlet
    e "Cycle."
    sta done,"%done%+1"
    sta a,"%random%*99/32767+1"
    igti a,"60",number
    ilti a,"61",letter
    l number
    e "Processing number..."
    sta q,"%random%*8/32767+1"
    st pass,"%pass%%q%"
    ieq done,"%num%",end
    g :numorlet
    l letter
    e "Processing letter..."
    sta cap,"%random%*99/32767+1"
    igti cap,"50",cap
    ilti cap,"51",low
    l cap
    sta capl,"%random%*25/32767+1"
    ieq capl,"1"
    st pass,"%pass%A"
    ieq capl,"2"
    st pass,"%pass%B"
    ieq capl,"3"
    st pass,"%pass%C"
    ieq capl,"4"
    st pass,"%pass%D"
    ieq capl,"5"
    st pass,"%pass%E"
    ieq capl,"6"
    st pass,"%pass%F"
    ieq capl,"7"
    st pass,"%pass%G"
    ieq capl,"8"
    st pass,"%pass%H"
    ieq capl,"9"
    st pass,"%pass%I"
    ieq capl,"10"
    st pass,"%pass%J"
    ieq capl,"11"
    st pass,"%pass%K"
    ieq capl,"12"
    st pass,"%pass%L"
    ieq capl,"13"
    st pass,"%pass%M"
    ieq capl,"14"
    st pass,"%pass%N"
    ieq capl,"15"
    st pass,"%pass%O"
    ieq capl,"16"
    st pass,"%pass%P"
    ieq capl,"17"
    st pass,"%pass%Q"
    ieq capl,"18"
    st pass,"%pass%R"
    ieq capl,"19"
    st pass,"%pass%S"
    ieq capl,"20"
    st pass,"%pass%T"
    ieq capl,"21"
