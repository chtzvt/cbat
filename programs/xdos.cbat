    e "2)Change Players"
    e "3)Close"
    stp v2,""
    ieq v2,"1",start
    ieq v2,"2",superstart
    ieq v2,"3",done
    l done
    l finend

.header
    filename "SP3.bat"
    entry 0
    ver 1.0
.instrs
    ttl "Rock, Paper, Scissors by William"
    clr 0E
    l titlescreen
    clr 0A
    e ""
    e ""
    e ""
    e "                               ************************************"
    e ""
    e "                                     ####      ####     ####"
    e "                                     ##  #     ##  #   #"
    e "                                     ##  #     ##  #   #"
    e "                                     ###       ####     ####"
    e "                                     ## #      ##          #"
    e "                                     ##  #  #  ##   #  ####  #"
    e ""
    e "                               ************************************"
    e ""
    e "                                                         By William"
    e ""
    e ""
    e "Start R.P.S?"
    e "Choosing "n" will exit the program."
    stp DOSTART,""
    ieq DOSTART,"y",start
    ieq DOSTART,"Y",start
    ieq DOSTART,"n",finend
    ieq DOSTART,"N",finend
    l start
    clr 0E
    cls
    e ""
    e ""
    e "What is your name?"
    e ""
    stp name,""
    e ""
    sta wins,"0"
    sta losses,"0"
    sta draws,"0"
    l choice
    cls
    clr 0E
    e ""
    e ""
    e "  Wins: %wins%"
    e "Losses: %losses%"
    e " Draws: %draws%"
    e ""
    e ""
    e "Choose"
    e ""
    e "1) Rock"
    e "2) Paper"
    e "3) Scissors"
    e ""
    stp cho,""
    e ""
    l a
    sta v,"%random%*3/32767+1"
    ieq v,"1",rock
    ieq v,"2",paper
    ieq v,"3",scissor
    g a
    l rock
    ieq cho,"1",rockrock
    ieq cho,"2",rockpaper
    ieq cho,"3",rockscissor
    l paper
    ieq cho,"1",paperrock
    ieq cho,"2",paperpaper
    ieq cho,"3",paperscissor
    l scissor
    ieq cho,"1",scissorrock
    ieq cho,"2",scissorpaper
    ieq cho,"3",scissorscissor
    l rockrock
    clr 0E
    cls
    sta draws,"%draws%+1"
    e ""
    e ""
    e "You chose Rock"
    e ""
    e "I chose Rock"
    e ""
    e "We tied...yet life goes on"
    e ""
    p
    g choice
    l rockpaper
    clr 0A
    cls
    sta wins,"%wins%+1"
    e ""
    e ""
    e "You chose Paper"
    e ""
    e "I chose Rock"
    e ""
    e "You Win :["
    e ""
    p
    g choice
    l rockscissor
    clr 0C
    cls
    sta losses,"%losses%+1"
    e ""
    e ""
    e "You chose Scissors"
    e ""
    e "I chose Rock"
    e ""
    e "You Lose :P"
    e ""
    p
    g choice
    l paperrock
    clr 0C
    cls
    sta losses,"%losses%+1"
    e ""
    e ""
    e "You chose Rock"
    e ""
    e "I chose Paper"
    e ""
    e "Haha %name%, you Suck at this!"
    e ""
    p
    g choice
    l paperscissor
    clr 0A
    cls
    sta wins,"%wins%+1"
    e ""
    e ""
    e "You chose Scissors"
    e ""
    e "I chose Paper"
    e ""
    e "Hmm you must have cheated...."
    e ""
    p
    g choice
    l paperpaper
    clr 0E
    cls
    sta draws,"%draws%+1"
    e ""
    e ""
    e "You chose Paper"
    e ""
    e "I too chose Paper"
    e ""
    e "Ugh I can't believe I tied with a loser like you"
    e ""
    p
    g choice
    l scissorrock
    clr 0A
    cls
    sta wins,"%wins%+1"
    e ""
    e ""
    e "Youu chose Rock"
    e ""
    e "I chose Scissors"
    e ""
    e "How the heck did I lose? I'm a freakin computer!"
    e "I can see what you pick!"
    e ""
    p
    g choice
    l scissorpaper
    clr 0C
    cls
    sta losses,"%losses%+1"
    e ""
    e ""
    e "You chose Paper"
    e ""
    e "I chose Scissors"
    e ""
    e "I am Victorious because I AM THE SMARTEST MAN ALIVE"
    e ""
    p
    g choice
    l scissorscissor
    clr 0E
    cls
    sta draws,"%draws%+1"
    e ""
    e ""
    e "You chose Scissors"
    e ""
    e "I chose Scissors"
    e ""
    e "Honestly %name%, this tying thing we've got going is"
    e "getting old. How bout you just let me win?"
    e ""
    p
    g choice
    l finend

.header
    filename "SP4.bat"
    entry 0
    ver 1.0
.instrs
    ttl "William's Calculator"
    clr 1F
    l menu
    cls
    e ""
    e ""
    e "--------------------"
    e " 1) Calculator"
    e " 2) Temp Converter"
    e " 3) Geometry"
    e " 4) Notes"
    e " 5) Exit"
    e "--------------------"
    stp menu,""
    ieq menu,"1",start
    ieq menu,"2",temp
    ieq menu,"3",geo
    ieq menu,"4",notes
    ieq menu,"5",closezx
    g menu
    l notes
    cls
    e ""
    e ""
    e "-------------------------------------------------"
    e " All answers generated will be within 1 of their"
    e " true value. The reason for the chance of error"
    e " is that batch files cannot handle decimals. If"
    e " I find away around this I will fix it."
    e "-------------------------------------------------"
    e "     Press any key to go back to the menu"
    p 0
    g menu
    l start
    cls
    e ""
    e "----------------------------------------------------------------------"
    e "  +    -      *        /       ans       menu"
    e " add minus multiply Divide  Prev. Ans Goto Menu"
    e "----------------------------------------------------------------------"
    e ""
    e "                                              Answer: %ans%"
    e ""
    stp equ,"Equation:"
    ieq equ,"menu",menu
    sta ans,"%equ%"
    cls
    g start
    l divide
    e "SUCCESS!"
    p
    df "check.txt"
    g start
    l exponent
    e "success"
    p
    df "check.txt"
    g start
    l temp
    cls
    e ""
    e ""
    e "-------------------"
    e " 1) F to C"
    e " 2) C to F"
    e " 3) F to K"
    e " 4) C to K"
    e " 5) K to F"
    e " 6) K to C"
    e " 7) Menu"
    e "-------------------"
    stp menu,""
    ieq menu,"1",FC
    ieq menu,"2",CF
    ieq menu,"3",FK
    ieq menu,"4",CK
    ieq menu,"5",KF
    ieq menu,"6",KC
    ieq menu,"7",menu
    igti menu,"7",temp
    ilti menu,"1",temp
    l FC
    e "-------------------"
    e "Temp Fahrenheit:"
    stp temp,""
    e "-------------------"
    sta temp,"%temp%-32"
    sta temp,"%temp%*5"
    sta temp,"%temp%/9"
    e ""
    e "Temp Celcius: %temp%"
    e ""
    e "-------------------"
    e ""
    e "Press Enter"
    p 0
    g temp
    l CF
    e "-------------------"
    e "Temp Celcius:"
    stp temp,""
    e "-------------------"
    sta temp,"%temp%*9"
    sta temp,"%temp%/5"
    sta temp,"%temp%+32"
    e ""
    e "Temp Fahrenheit: %temp%"
    e ""
    e "-------------------"
    e ""
    e "Press Enter"
    p 0
    g temp
    l FK
    e "-------------------"
    e "Temp Fahrenheit:"
    stp temp,""
    e "-------------------"
    sta temp,"%temp%-32"
    sta temp,"%temp%*5"
    sta temp,"%temp%/9"
    sta temp,"%temp%+273"
    e ""
    e "Temp Kelvin: %temp%"
    e ""
    e "-------------------"
    e ""
    e "Press Enter"
    p 0
    g temp
    l CK
    e "-------------------"
    e "Temp Celcius:"
    stp temp,""
    e "-------------------"
    sta temp,"%temp%+273"
    e ""
    e "Temp Kelvin: %temp%"
    e ""
    e "-------------------"
    e ""
    e "Press Enter"
    p 0
    g temp
    l KF
    e "-------------------"
    e "Temp Kelvin:"
    stp temp,""
    e "-------------------"
    sta temp,"%temp%-273"
    sta temp,"%temp%*9"
    sta temp,"%temp%/5"
    sta temp,"%temp%+32"
    e ""
    e "Temp Fahrenheit: %temp%"
    e ""
    e "-------------------"
    e ""
    e "Press Enter"
    p 0
    g temp
    l KC
    e "-------------------"
    e "Temp Kelvin:"
    stp temp,""
    e "-------------------"
    sta temp,"%temp%-273"
    e ""
    e "Temp Celcius: %temp%"
    e ""
    e "-------------------"
    e ""
    e "Press Enter"
    p 0
    g temp
    l geo
    cls
    e ""
    e ""
    e "--------------------"
    e " 1) Area"
    e " 2) Volume"
    e " 3) Surface Area"
    e " 4) Circumference"
    e " 5) Menu"
    e "--------------------"
    e ""
    e "Choose a Category"
    e ""
    stp choice,""
    ieq choice,"1",area
    ieq choice,"2",volume
    ieq choice,"3",sarea
    ieq choice,"4",circum
    ieq choice,"5",menu
    g geo
    l area
    cls
    e ""
    e ""
    e "-----------------------"
    e " 1)Square or Rectangle"
    e " 2)Triangle"
    e " 3)Trapezoid"
    e " 4)Circle"
    e " 5)Menu"
    e "-----------------------"
    e ""
    stp choice,""
    ieq choice,"1",rect
    ieq choice,"2",tri
    ieq choice,"3",trap
    ieq choice,"4",cir
    ieq choice,"5",menu
    g area
    l rect
    cls
    e ""
    e ""
    e "------------------"
    e "    RECTANGLE"
    e "------------------"
    e ""
    e ""
    e "  Length="
    stp len,""
    e ""
    e "  Width="
    stp wid,""
    sta area,"%len%*%wid%"
